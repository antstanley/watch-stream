{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"lib": ["esnext"],
		"types": ["node"],
		"declaration": false,
		"sourceMap": false,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src/cli/**/*.ts", "src/lib/cli/**/*.ts", "src/lib/time-range.ts"]
}
