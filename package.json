{
	"name": "watch-stream",
	"version": "0.0.1",
	"private": true,
	"description": "Tail Amazon CloudWatch Logs in a local web app",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"knip": "knip",
		"verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm knip && pnpm build",
		"floci:start": "floci start",
		"floci:stop": "floci stop",
		"floci:env": "node scripts/floci-env.ts",
		"floci:up": "floci start && node scripts/floci-env.ts",
		"seed": "node scripts/seed-floci.ts",
		"seed:watch": "node scripts/seed-floci.ts --watch",
		"test:e2e": "WATCH_STREAM_E2E=1 vitest run --project integration",
		"dev:aws": "node scripts/dev.ts",
		"start:aws": "node scripts/dev.ts --start",
		"test:ui": "node scripts/ui-smoke.ts"
	},
	"dependencies": {
		"@aws-sdk/client-cloudwatch-logs": "^3.1129.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.2",
		"jsdom": "^30.0.1",
		"knip": "^6.35.1",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"playwright": "^1.63.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
