# watch-tail configuration example.
# Real AWS: leave the endpoint variables unset and use ambient credentials
# (AWS_PROFILE, SSO, environment, shared credentials file, instance role).

# Default region for the UI and the AWS SDK.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Override the CloudWatch Logs endpoint. Point it at floci to run fully local.
# AWS_ENDPOINT_URL_LOGS=http://localhost:4566
# AWS_ENDPOINT_URL=http://localhost:4566

# Regions offered by the region picker (comma separated).
WATCH_TAIL_REGIONS=us-east-1,us-west-2,eu-west-1

# Default page size for describe-log-groups.
WATCH_TAIL_LIMIT=200
# Archive defaults to one file per account and region under the platform data directory.
# WATCH_TAIL_ARCHIVE_DIR=/path/to/archives
# Explicit legacy/custom file override (bypasses account/region separation):
# WATCH_TAIL_ARCHIVE_DB=/path/to/archive.duckdb
