{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/routes/**/+*.{svelte,ts,js}", "scripts/*.ts", "src/cli/bin.ts"],
	"project": ["src/**/*.{ts,svelte}", "scripts/**/*.ts", "*.config.ts"],
	"ignoreDependencies": ["tailwindcss"],
	"ignoreBinaries": ["floci", "publint"],
	"vitest": {
		"entry": ["src/**/*.{test,spec}.{ts,js}"]
	}
}
